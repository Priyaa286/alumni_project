PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/nec-alumni

# The sole account allowed to access /admin. Do not put this value in the client.
ADMIN_EMAIL=admin@example.edu
# Use a long random value in each environment.
AUTH_TOKEN_SECRET=replace-with-a-long-random-secret

# Public URL included in alumni invitation emails. It must end with /nomination.
NOMINATION_FORM_URL=https://your-portal.example.edu/nomination

SMTP_HOST=smtp.example.edu
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
EMAIL_FROM="NEC Alumni Portal <alumni@example.edu>"
