PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/nec-alumni
# Optional private CSV activity imports (defaults to these files in backend/data/private).
WEBINAR_SPEAKERS_CSV=./data/private/webinar.speakers.csv
MENTOR_REGISTRATIONS_CSV=./data/private/mentorship.mentorregistrations.csv
# Mentor registrations contain mentor IDs; this collection must map those IDs to mentor email addresses.
MENTOR_PROFILE_COLLECTION=mentors
# Comma-separated administrator email addresses
ADMIN_EMAILS=admin@example.edu
# Comma-separated emails of the current serving Notable Alumni Approval Committee.
# Update this list when the committee changes; members cannot nominate or be nominated.
NOTABLE_ALUMNI_COMMITTEE_EMAILS=
# Generate a long random secret, for example with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_TOKEN_SECRET=replace-with-a-long-random-secret
# Local only: enables sign-in on localhost without email or Google. Never enable in production.
LOCAL_DEV_AUTH=true

# Set this to the Project ID in Firebase Console > Project settings
FIREBASE_PROJECT_ID=your-firebase-project-id

# Optional mail settings for OTP, nominee verification, and back-office approval emails.
# Local development sign-in works without SMTP when LOCAL_DEV_AUTH=true.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASS=your-email-app-password
EMAIL_FROM=NEC Alumni Portal <your-email@example.com>

APP_BASE_URL=https://your-portal.example.edu
NOMINATION_FORM_URL=https://your-portal.example.edu/nomination
